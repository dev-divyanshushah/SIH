# PERSIST-AIR Environment Configuration

# Database
DATABASE_URL=sqlite+aiosqlite:///./persist_air.db
# For PostgreSQL production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/persist_air

# Server Security & Config
SECRET_KEY=persist-air-production-secret-key-change-this
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# External ML Service Integration Endpoint
ML_SERVICE_URL=http://localhost:8001
